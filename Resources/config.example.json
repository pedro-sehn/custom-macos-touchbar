{
  "presentOnLaunch": true,
  "refreshSeconds": 1.0,
  "controlStripTitle": "▚",
  "language": "auto",

  "widgets": [
    { "type": "clock", "options": { "format": "EEE HH:mm" } },
    {
      "type": "graph",
      "options": {
        "source": "cpu",
        "caption": "CPU",
        "width": 80,
        "color": "#4ADE80"
      }
    },
    { "type": "battery", "options": { "showTime": true } },
    {
      "type": "slider",
      "options": { "label": "Vol", "target": "volume", "min": 0, "max": 100 }
    },

    {
      "type": "toggle",
      "options": { "target": "caffeinate", "onTitle": "☕️", "offTitle": "💤" }
    },
    {
      "type": "toggle",
      "options": { "target": "darkmode", "onTitle": "🌙", "offTitle": "☀️" }
    },
    { "type": "pomodoro", "options": { "minutes": 25, "breakMinutes": 5 } },

    {
      "type": "group",
      "id": "crypto",
      "options": {
        "label": "₿",
        "widgets": [
          { "type": "crypto", "options": { "symbol": "BTC", "currency": "usd" } },
          { "type": "crypto", "options": { "symbol": "ETH", "currency": "eur" } },
          { "type": "crypto", "options": { "symbol": "BTC", "currency": "brl" } }
        ]
      }
    },

    {
      "type": "group",
      "id": "tools",
      "options": {
        "label": "🧰",
        "widgets": [
          {
            "type": "shortcut",
            "id": "screenshot",
            "options": {
              "title": "📸",
              "action": "shell",
              "command": "screencapture -i ~/Desktop/shot-$(date +%s).png",
              "longPress": {
                "action": "shell",
                "command": "screencapture -W ~/Desktop/window-$(date +%s).png"
              }
            }
          },
          {
            "type": "shortcut",
            "id": "lock",
            "options": {
              "title": "🔒",
              "action": "hotkey",
              "keys": ["ctrl", "cmd", "q"]
            }
          },
          {
            "type": "media",
            "options": { "showTitle": true, "titleWidth": 140 }
          }
        ]
      }
    },

    {
      "type": "group",
      "id": "clip",
      "options": {
        "label": "📋",
        "widgets": [
          {
            "type": "clipboard",
            "options": { "capacity": 12, "cellWidth": 110, "paste": true }
          }
        ]
      }
    }
  ],

  "apps": {
    "com.googlecode.iterm2": [
      { "type": "clock", "options": { "format": "HH:mm" } },
      {
        "type": "graph",
        "options": { "source": "cpu", "caption": "CPU", "width": 80 }
      },
      {
        "type": "shortcut",
        "options": { "title": "git status", "action": "hotkey", "keys": ["g"] }
      },
      { "type": "clipboard", "options": { "capacity": 8, "cellWidth": 120 } }
    ],

    "company.thebrowser.Browser": [
      { "type": "clock", "options": { "format": "HH:mm" } },
      {
        "type": "shortcut",
        "options": {
          "title": "↩︎ Tab",
          "action": "hotkey",
          "keys": ["cmd", "shift", "t"]
        }
      },
      {
        "type": "shortcut",
        "options": { "title": "🔍", "action": "hotkey", "keys": ["cmd", "f"] }
      },
      { "type": "media", "options": { "showTitle": true, "titleWidth": 200 } },
      { "type": "battery", "options": { "showTime": false } }
    ]
  }
}
